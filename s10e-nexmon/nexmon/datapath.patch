index 0000000..b86ef4a
--- /dev/null
+++ b/patches/bcm4375b1/18_41_117_sta/nexmon/src/datapath.c
@@ -0,0 +1,234 @@
+#pragma NEXMON targetregion "patch"
+
+#include <firmware_version.h>
+#include <wrapper.h>
+#include <structs.h>
+#include <helper.h>
+#include <patcher.h>
+#include <local_wrapper.h>
+
+/*
+ * Data-path injection (mosey). Host frames sent on the normal netdev TX path (bcmdhd flow rings)
+ * reach dngl_sendwl (0x1853C0), which hands a chain of packets to dev->ops->xmit (wl_send) with
+ * "blx r6" at 0x18545A. While monitor mode is on, packets that start with a radiotap header are
+ * injected instead. Everything else goes to wl_send unchanged.
+ *
+ * Host packets are lfrags: only the first p->len bytes (the 14-byte "ethernet header") are in
+ * dongle memory, the rest stays in host memory (address at +0x44/+0x48, length at +0x54).
+ * hnd_pktfetch (0x1D4630) DMAs that host part into a new dongle lbuf; the completion callback
+ * prepends the inline bytes and injects the rebuilt frame, then frees the lfrag (which releases
+ * the host buffer through the normal tx-status path).
+ *
+ * Packets in the chain are linked by 16-bit ids at offset 0x1A, resolved through the packet
+ * table whose address is stored at 0x1701A4 (same lookup as dngl_sendwl).
+ */
+
+typedef int (*xmit_fn)(void *src, void *dev, struct sk_buff *p);
+
+struct wlc_info *nex_wlc = 0;             /* set by wlc_ioctl_hook */
+/* calls, fetch queued, fetch failed, cb ok, cb cancelled, last inline|host len << 16,
+ * non-radiotap dropped, injected */
+unsigned int nex_dp_stat[8] = { 0 };
+
+void *inject_frame(struct wlc_info *wlc, struct sk_buff *p);
+
+#define PKT_TABLE_PTR   0x1701A4
+#define LFRAG_HOSTLEN(p) (*(unsigned short *) ((unsigned char *) (p) + 0x54))
+#define FETCH_HEADROOM  256               /* TXOFF (204) + inline bytes */
+#define AMSDU_HEAD      0xa1
+#define AMSDU_TAIL      0xa2
+#define AMSDU_MID       0xa3
+#define LBUF_NEXTID     0x18
+
+struct pktfetch_info {
+    void *osh;
+    void *lfrag;
+    unsigned short headroom;
+    short host_offset;
+    void (*cb)(struct sk_buff *lb, struct sk_buff *orig, void *ctx, int cancelled);
+    void *ctx;
+    void *next;
+};
+
+struct fetch_ctx {
+    struct pktfetch_info *pinfo;
+};
+
+#define fw_mallocz(n)       ((void *(*)(unsigned int)) 0x61305)(n)
+#define fw_free(p)          ((void (*)(void *)) 0x61335)(p)
+#define fw_pktfetch(pi)     ((int (*)(struct pktfetch_info *)) 0x1D4631)(pi)
+#define fw_pkt_free(o, p, s) ((void (*)(void *, void *, int)) 0x186EC9)(o, p, s)
+
+static int
+is_radiotap(const unsigned char *d, unsigned int len)
+{
+    unsigned int rl;
+
+    if (len < 8)
+        return 0;
+    rl = d[2] | (d[3] << 8);
+    /* d[1]: radiotap pad, used by the host to mark the halves of an A-MSDU pair */
+    return d[0] == 0 && (d[1] == 0 || (d[1] >= AMSDU_HEAD && d[1] <= AMSDU_MID)) &&
+           rl >= 8 && rl <= 64;
+}
+
+/* The host cannot send frames over 1600 bytes, and one dongle buffer holds under 2000. An A-MSDU
+ * therefore arrives as two packets: the head (radiotap, 802.11 header, first subframe with its
+ * padding) and the tail (8 byte marker, second subframe). The tail buffer is chained to the head
+ * (lbuf nextid) and the chain goes out as one frame. */
+static struct sk_buff *amsdu_head = 0;
+static struct sk_buff *amsdu_last = 0;      /* end of the chain being collected */
+unsigned int nex_amsdu_stat[3] = { 0 };     /* pairs sent, heads dropped, tails dropped */
+
+static void
+emit(struct wlc_info *wlc, struct sk_buff *lb)
+{
+    unsigned char *d = (unsigned char *) lb->data;
+
+    if (d[1] == AMSDU_HEAD) {
+        if (amsdu_head) {
+            nex_amsdu_stat[1]++;
+            fw_pkt_free(wlc->osh, amsdu_head, 0);
+        }
+        amsdu_head = amsdu_last = lb;
+        return;
+    }
+    if (d[1] == AMSDU_TAIL || d[1] == AMSDU_MID) {
+        struct sk_buff *head = amsdu_head;
+        struct sk_buff **table = *(struct sk_buff ***) PKT_TABLE_PTR;
+        unsigned short id = *(unsigned short *) lb;
+
+        if (!head || table[id] != lb) {
+            nex_amsdu_stat[2]++;
+            amsdu_head = 0;
+            if (head)
+                fw_pkt_free(wlc->osh, head, 0);
+            fw_pkt_free(wlc->osh, lb, 0);
+            return;
+        }
+        int more = d[1] == AMSDU_MID;
+        skb_pull(lb, 8);
+        *(unsigned short *) ((unsigned char *) amsdu_last + LBUF_NEXTID) = id;
+        if (more) {
+            amsdu_last = lb;
+            return;
+        }
+        amsdu_head = 0;
+        ((unsigned char *) head->data)[1] = 0;
+        nex_amsdu_stat[0]++;
+        nex_dp_stat[7]++;
+        inject_frame(wlc, head);
+        return;
+    }
+    nex_dp_stat[7]++;
+    inject_frame(wlc, lb);
+}
+
+static void
+fetch_done(struct sk_buff *lb, struct sk_buff *orig, void *ctx, int cancelled)
+{
+    struct fetch_ctx *fc = (struct fetch_ctx *) ctx;
+    struct wlc_info *wlc = nex_wlc;
+
+    if (fc) {
+        fw_free(fc->pinfo);
+        fw_free(fc);
+    }
+    if (cancelled || !lb || !orig || !wlc) {
+        nex_dp_stat[4]++;
+        return;
+    }
+    nex_dp_stat[3]++;
+    skb_push(lb, orig->len);
+    memcpy(lb->data, orig->data, orig->len);
+    fw_pkt_free(wlc->osh, orig, 1);
+    if (is_radiotap((unsigned char *) lb->data, lb->len)) {
+        emit(wlc, lb);
+    } else {
+        fw_pkt_free(wlc->osh, lb, 0);
+    }
+}
+
+static void
+inject_host(struct wlc_info *wlc, struct sk_buff *p)
+{
+    struct pktfetch_info *pi;
+    struct fetch_ctx *fc;
+    unsigned int hl = LFRAG_HOSTLEN(p);
+
+    nex_dp_stat[5] = p->len | hl << 16;
+    if (hl == 0) {                        /* whole frame already in dongle memory */
+        emit(wlc, p);
+        return;
+    }
+    if (p->len > 64)
+        goto drop;
+    pi = fw_mallocz(sizeof(*pi));
+    fc = fw_mallocz(sizeof(*fc));
+    if (!pi || !fc) {
+        if (pi) fw_free(pi);
+        if (fc) fw_free(fc);
+        goto drop;
+    }
+    fc->pinfo = pi;
+    pi->osh = wlc->osh;
+    pi->lfrag = p;
+    pi->headroom = FETCH_HEADROOM;
+    pi->host_offset = 0;
+    pi->cb = fetch_done;
+    pi->ctx = fc;
+    if (fw_pktfetch(pi) == 0) {
+        nex_dp_stat[1]++;
+        return;
+    }
+    fw_free(pi);
+    fw_free(fc);
+drop:
+    nex_dp_stat[2]++;
+    fw_pkt_free(wlc->osh, p, 1);
+}
+
+int
+dngl_xmit_hook(void *src, void *dev, struct sk_buff *p, xmit_fn xmit)
+{
+    struct wlc_info *wlc = nex_wlc;
+    struct sk_buff **table;
+
+    if (!wlc || (!wlc->monitor && !((struct wlc_info *) get_other_wlc(wlc))->monitor))
+        return xmit(src, dev, p);
+
+    table = *(struct sk_buff ***) PKT_TABLE_PTR;
+    while (p) {
+        unsigned short next_id = p->field1A;
+        struct sk_buff *next = next_id ? table[next_id] : 0;
+
+        nex_dp_stat[0]++;
+        p->field1A = 0;
+        if (is_radiotap((unsigned char *) p->data, p->len)) {
+            inject_host(wlc, p);
+        } else {
+            /* ordinary host traffic while the station is down for monitor mode: wl_send would
+             * reject it without freeing it, and leaked lfrags stall the flow rings */
+            nex_dp_stat[6]++;
+            fw_pkt_free(wlc->osh, p, 1);
+        }
+        p = next;
+    }
+    return 0;
+}
+
+/* Replaces "mov r2, sl; blx r6" in dngl_sendwl: r0 = src, r1 = dev, sl = packet chain,
+ * r6 = wl_send. Returns to the instruction after the blx with the result in r0. */
+__attribute__((naked))
+void
+dngl_xmit_stub(void)
+{
+    asm(
+        "mov r2, sl\n"
+        "mov r3, r6\n"
+        "b dngl_xmit_hook\n"
+    );
+}
+
+__attribute__((at(0x185458, "", CHIP_VER_BCM4375b1, FW_VER_18_41_117_sta)))
+BLPatch(dngl_xmit_stub, dngl_xmit_stub);
